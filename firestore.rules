rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public rider profiles. Anyone signed in can read a public profile;
    // only the owner can write their own, and only within sane ranges
    // for the physical-measurement fields used in power estimates.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && (!('weightKg' in request.resource.data) || request.resource.data.weightKg == null || (request.resource.data.weightKg is number && request.resource.data.weightKg > 20 && request.resource.data.weightKg < 300))
        && (!('heightCm' in request.resource.data) || request.resource.data.heightCm == null || (request.resource.data.heightCm is number && request.resource.data.heightCm > 80 && request.resource.data.heightCm < 260))
        && (!('bikeWeightKg' in request.resource.data) || request.resource.data.bikeWeightKg == null || (request.resource.data.bikeWeightKg is number && request.resource.data.bikeWeightKg > 0 && request.resource.data.bikeWeightKg < 60));
      allow delete: if false;
    }

    // Follow graph. A rider can only create/delete their own outgoing
    // follow edges; the graph is readable so "who follows whom" can be
    // shown, matching most social apps' default openness.
    match /follows/{edgeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerUid;
      allow update: if false;
    }

    // Public activity feed entries. Only the owner can create/update
    // their own activity; kudosCount/commentCount are maintained via the
    // subcollections below through the increment() calls in the app, not
    // arbitrary client edits, though Firestore rules alone can't enforce
    // an exact +1/-1 tie to a matching subdocument write — counts are
    // treated as eventually-consistent/approximate by design (see the
    // Ridewise reform plan's Phase 4 notes).
    match /activities/{activityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.ownerId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudosCount', 'commentCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /kudos/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.authorUid;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.authorUid || request.auth.uid == get(/databases/$(database)/documents/activities/$(activityId)).data.ownerId);
        allow update: if false;
      }
    }

    // Clubs, their group rides and challenges. Any signed-in rider can read
    // and join; only the creator can edit or delete the club itself, and
    // membership/attendance docs are self-service (you can only add or remove
    // your own).
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && (request.auth.uid == resource.data.createdBy
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
        allow update: if request.auth != null && (request.auth.uid == resource.data.createdBy
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goingCount']));
        allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

        match /attendees/{uid} {
          allow read: if request.auth != null;
          allow create, delete: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
        }
      }
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Route ratings and ride counts. The aggregate doc is recomputed by the
    // client from the ratings it can read, so a rider can only ever write
    // their own star rating.
    match /routeStats/{routeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Segments and efforts. Anyone signed in can create a segment and record
    // their own effort on it; efforts are keyed by rider so nobody can post a
    // time on someone else's behalf.
    match /segments/{segmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && (request.auth.uid == resource.data.createdBy
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effortCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /efforts/{effortId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
        allow update: if false;
      }
    }

    // Pre-existing collections from before this reform (private saved
    // routes/activities, live-journey sharing, shared-route links) —
    // unchanged from how the app already used them.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /journeys_v4/{journeyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    match /shared_routes_v1/{routeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
