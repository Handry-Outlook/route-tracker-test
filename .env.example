# Copy to .env and fill in. .env is git-ignored; this file is not.
#
# The Mapbox token and Firebase config are sent by the browser, so they are
# readable in the built bundle by design. They are protected by restrictions on
# the service, not by being hidden:
#   - Mapbox: restrict the token to your domains at account.mapbox.com
#   - Firebase: security is enforced by firestore.rules and storage.rules
# Keeping them here rather than in source stops them entering git history and
# lets each checkout point at its own project.

# Required. Without it the map will not load.
MAPBOX_TOKEN=pk.your_mapbox_token_here

# Required for sign-in, saved routes, clubs and the feed. One line of JSON,
# copied from your Firebase project settings.
FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# OPTIONAL, and best left empty.
#
# X_WEATHER_SECRET is a real API secret: anything the browser sends is visible
# in dist/app.js, so filling this in publishes it to every visitor. The app
# falls back to Open-Meteo, which needs no key and returns the same wind,
# temperature, humidity and hourly forecast data — so leaving these blank costs
# no functionality.
#
# To use Xweather in production, proxy the call through a serverless function
# that holds the secret server-side and forwards the response.
X_WEATHER_ID=
X_WEATHER_SECRET=
